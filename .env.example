# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA suba o arquivo .env para o GitHub.

# Chave da API OpenWeather (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=sua_chave_openweather_aqui

# Token do bot do Telegram (gerado pelo @BotFather).
# Usado ao criar a credencial "Telegram API" dentro do n8n.
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui

# URL publica HTTPS do n8n (ex.: gerada pelo ngrok). Necessaria para o Telegram Trigger.
WEBHOOK_URL=https://sua-url.ngrok-free.app/

# (Opcional) Chave do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
